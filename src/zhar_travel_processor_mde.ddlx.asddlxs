@Metadata.layer: #CUSTOMER
@UI.headerInfo : { 
    title.value : 'TravelId',
    description.value: 'Description',
    typeName: 'TravelRequest',
    typeNamePlural: 'TravelRequests'
}
annotate entity zhar_travel_processor
    with 
{
    @UI.facet: [
            
            { purpose : #HEADER,
              type : #FIELDGROUP_REFERENCE,
              id : 'HeaderTotalprice',
              targetQualifier: 'HeaderDatas',
              label: 'QuickView'  
              
            },
            { purpose : #STANDARD,
              type : #COLLECTION,
              id : 'Tabstrip_Holder1',
              label: 'General Information',
              position: 10             
            },
            { purpose : #STANDARD,
              type : #COLLECTION,
              id : 'Tabstrip_Holder2',
              label: 'Additional DataTab1',
              position: 20             
            },
            { 
                purpose: #STANDARD,
                type:  #IDENTIFICATION_REFERENCE,
                position: 10,
                parentId: 'Tabstrip_Holder1',
                label: 'Basic Data',
                targetQualifier: 'Tabstrip1_Box1'
                
            },
            { 
                purpose: #STANDARD,
                type:  #FIELDGROUP_REFERENCE,
                position: 20,
                label: 'Important Dates',
                parentId: 'Tabstrip_Holder1',
               targetQualifier: 'Tabstrip1_Box2'
            } 

    
    
    ]
    @UI.selectionField: [{ position: 10 }]
    @UI.lineItem: [{ position: 10 }]
    @UI.fieldGroup: [{ label: 'MyTravelId' ,qualifier: 'HeaderDatas' ,position: 10 }]
    @UI.identification: [{ position: 10 , qualifier: 'Tabstrip1_Box1' }]
    TravelId;
     @UI.selectionField: [{ position: 20 }]
     @UI.lineItem: [{ position: 20 }]
     @UI.identification: [{ position: 20 , qualifier: 'Tabstrip1_Box1' }]
    AgencyId;
     @UI.selectionField: [{ position: 30 }]
     @UI.lineItem: [{ position: 30 }]
    CustomerId;
    @UI.lineItem: [{ position: 40 }]
    @UI.fieldGroup: [{ position: 10 , qualifier: 'Tabstrip1_Box2' }]
    BeginDate;
    @UI.fieldGroup: [{ position: 20 , qualifier: 'Tabstrip1_Box2' }]
    EndDate;
//    BookingFee;
     @UI.selectionField: [{ position: 40 }]
     @UI.lineItem: [{ position: 50 }]
     @UI.fieldGroup: [{ label:  'Total Travel Expenses' ,qualifier: 'HeaderDatas',position: 20 }]
    @UI.identification: [{ position: 30 , qualifier: 'Tabstrip2_Box1' }]
    TotalPrice;
//    CurrencyCode;
//    Description;
     @UI.selectionField: [{ position: 50 }]
     @UI.lineItem: [{ position: 60 , criticality: 'status_code' ,  importance: #HIGH }]
    @UI.identification: [{ position: 40 , qualifier: 'Tabstrip2_Box1' }]
    OverallStatus;
//    CreatedBy;
//    CreatedAt;
//    LastChangedBy;
//    LastChangedAt;

    
}